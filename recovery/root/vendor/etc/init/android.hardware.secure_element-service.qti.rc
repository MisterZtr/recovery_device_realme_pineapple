# QSEECom_start_app. se_omapi proxies to it, and that is how the weaver
# transport reaches the eSE.
service vendor.secure_element /vendor/bin/hw/android.hardware.secure_element-service.qti
    disabled
    class hal
    user root
    group nfc root
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib64/hw:/system/lib64:/sbin:/odm/lib64
    seclabel u:r:recovery:s0
