# Started from prepdecrypt.sh, which first points the version properties at the
# installed system. The HAL reads them in its constructor and hands them to the
# TA, so starting it any earlier binds the TA to recovery's own values.
service vendor.keymint-qti /vendor/bin/hw/android.hardware.security.keymint-service-qti
    disabled
    class early_hal
    user root
    group root drmrpc
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib64/hw:/system/lib64:/sbin:/odm/lib64
    seclabel u:r:recovery:s0
